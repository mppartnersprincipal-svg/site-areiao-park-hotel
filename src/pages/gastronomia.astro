---
import PageLayout from "@/layouts/PageLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Split from "@/components/sections/Split.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import ExperienceTile from "@/components/cards/ExperienceTile.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { site } from "@/data/site";

const mapsUrl = (name: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name} Goiânia`)}`;

import heroFoto from "@/assets/images/gastronomia/cafe-buffet-07.png";
import splitFoto from "@/assets/images/gastronomia/cafe-mesa.jpg";
import variedadeFoto from "@/assets/images/gastronomia/cafe-variedade.jpg";
import ambienteFoto from "@/assets/images/gastronomia/cafe-ambiente.jpg";
---

<PageLayout
  title="Gastronomia"
  description="Café da manhã reconhecido pela variedade e um restaurante com cardápio vasto. A gastronomia que marca a estadia no Areião Park Hotel."
  path="/gastronomia"
  whatsappOrigem="Gastronomia"
>
  <section class="section" style="padding-bottom:clamp(40px,5vw,64px);">
    <div class="guide">
      <Hero
        eyebrow="Gastronomia"
        title="A mesa que dá o tom da sua estadia"
        text="Do café da manhã ao jantar em família, sabores que ficam na memória."
        image={heroFoto}
        imageAlt="Mesa do café da manhã do Areião Park Hotel"
        as="h2"
      />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="guide">
      <Split
        eyebrow="Café da manhã"
        title="Comece o dia como ele merece"
        text="Nosso café da manhã é reconhecido pela variedade: pães artesanais, bolos caseiros, tapioca feita na hora, frutas e sucos naturais. Uma mesa farta para começar bem o dia, seja a trabalho ou a passeio."
        image={splitFoto}
        imageAlt="Variedade do café da manhã"
      />

      <div style="margin-top:60px;">
        <SectionHead eyebrow="Restaurante" title="Um cardápio para todos os paladares">
          Do almoço executivo ao jantar tranquilo, nosso restaurante tem opções
          para todos os momentos. Ingredientes selecionados e o tempero de quem
          cozinha com cuidado.
        </SectionHead>
      </div>

      <div class="exp-grid exp-grid--two">
        <ExperienceTile
          eyebrow="Café da manhã"
          title="Variedade feita na hora"
          text="Pães, bolos, tapioca e sucos naturais"
          image={variedadeFoto}
          imageAlt="Variedade do café da manhã feita na hora no Areião Park Hotel"
        />
        <ExperienceTile
          eyebrow="Ambiente"
          title="Aconchego à mesa"
          text="Um espaço acolhedor para suas refeições"
          image={ambienteFoto}
          imageAlt="Buffet do café da manhã servido no Areião Park Hotel"
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="guide">
      <SectionHead eyebrow="Na região" title="Sabores na vizinhança">
        Hospedar-se ao lado do Parque Areião também é estar a poucos minutos a
        pé de alguns dos restaurantes mais famosos de Goiânia. Uma seleção para
        explorar durante a estadia.
      </SectionHead>

      <ul class="resto-grid">
        {
          site.nearbyRestaurants.map((r) => (
            <li>
              <a
                class="resto-card"
                href={mapsUrl(r.name)}
                target="_blank"
                rel="noopener"
              >
                <span class="eyebrow">{r.cuisine}</span>
                <h3>{r.name}</h3>
                <span class="resto-dist">≈ {r.distance} do hotel</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top:clamp(48px,6vw,80px);">
    <div class="guide">
      <CtaBand
        title="Reserve sua estadia e prove você mesmo"
        origem="Gastronomia"
      />
    </div>
  </section>

  <style>
    .resto-grid {
      list-style: none;
      margin: 40px 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
    .resto-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      height: 100%;
      padding: 26px 24px 22px;
      background: var(--white);
      border: 1px solid var(--sand-300);
      border-radius: var(--r-lg);
      text-decoration: none;
      color: inherit;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }
    .resto-card:hover,
    .resto-card:focus-visible {
      border-color: var(--gold-400);
      box-shadow: var(--shadow-1);
      transform: translateY(-2px);
    }
    .resto-card .eyebrow {
      color: var(--ink-700);
    }
    .resto-card h3 {
      font-size: 26px;
    }
    .resto-dist {
      margin-top: auto;
      padding-top: 10px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--ink-700);
    }
    .resto-dist::before {
      content: "";
      display: inline-block;
      width: 18px;
      height: 1px;
      background: var(--gold-500);
      vertical-align: middle;
      margin-right: 10px;
    }
    @media (max-width: 900px) {
      .resto-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .resto-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .resto-card {
        transition: none;
      }
      .resto-card:hover,
      .resto-card:focus-visible {
        transform: none;
      }
    }
  </style>
</PageLayout>
