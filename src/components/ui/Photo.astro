---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Preenche um bloco .ph-photo com imagem otimizada (WebP/AVIF, srcset, lazy).
 * Mantém o gradiente placeholder como fundo até a foto carregar.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  green?: boolean;
  class?: string;
  /** Acima da dobra (hero) → eager + alta prioridade. */
  eager?: boolean;
  sizes?: string;
  widths?: number[];
}
const {
  src,
  alt = "",
  green = false,
  class: extraClass = "",
  eager = false,
  sizes = "(max-width: 900px) 100vw, 33vw",
  widths = [400, 600, 900, 1200],
} = Astro.props;

const cls = ["ph-photo", green ? "green" : "", src ? "has-img" : "", extraClass]
  .filter(Boolean)
  .join(" ");
---

<div class={cls}>
  {
    src && (
      <Image
        class="fill"
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={eager ? "high" : "auto"}
      />
    )
  }
  <slot />
</div>
