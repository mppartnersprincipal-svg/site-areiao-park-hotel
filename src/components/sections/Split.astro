---
import Photo from "@/components/ui/Photo.astro";
import type { ImageMetadata } from "astro";

/** Bloco split claro/escuro (DS §08). Lado escuro com texto + ação; lado foto. */
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, text, image, imageAlt = "" } = Astro.props;
---

<div class="split on-dark">
  <div class="dark">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {text && <p>{text}</p>}
    <slot name="actions" />
  </div>
  <div class="photo">
    <Photo src={image} alt={imageAlt} green={!image} sizes="(max-width: 860px) 100vw, 50vw" />
  </div>
</div>
