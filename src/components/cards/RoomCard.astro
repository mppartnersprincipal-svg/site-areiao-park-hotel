---
import Photo from "@/components/ui/Photo.astro";
import Button from "@/components/ui/Button.astro";
import { buildReservationUrl, RESERVE_LINK_ATTRS } from "@/lib/hsystem";
import type { ImageMetadata } from "astro";

interface RoomData {
  nome: string;
  eyebrow: string;
  camas: string;
  capacidade: string;
  metragem?: string;
  vista?: string;
  descricao: string;
  amenidades: string[];
  foto: ImageMetadata;
  alt: string;
  precoLabel: string;
  preco: string;
  roomType?: string;
}
interface Props {
  room: RoomData;
}
const { room } = Astro.props;
const reserveUrl = buildReservationUrl({ roomType: room.roomType });
const area = [room.metragem, room.camas].filter(Boolean).join(" · ");
---

<article class="room">
  <Photo
    src={room.foto}
    alt={room.alt}
    class="room-photo"
    sizes="(max-width: 900px) 100vw, 33vw"
    widths={[400, 600, 800]}
  >
    <span class="pin">{room.eyebrow}</span>
  </Photo>
  <div class="pad">
    <span class="ey">{room.eyebrow}</span>
    <h3>{room.nome}</h3>
    <div class="area">{area}</div>
    <p class="desc">{room.descricao}</p>
    <ul class="amen">
      {room.amenidades.map((a) => <li>{a}</li>)}
    </ul>
    <div class="foot">
      <Button
        variant="link"
        href={reserveUrl}
        {...RESERVE_LINK_ATTRS}
        data-track="click_reservar"
        data-origem={`Acomodação · ${room.nome}`}
      >
        Reservar
      </Button>
    </div>
  </div>
</article>

<style>
  /* O placeholder .ph-photo do DS tem altura 210px só dentro de .room;
     garantimos que a foto preencha esse espaço. */
  .room :global(.room-photo) {
    height: 210px;
  }
</style>
