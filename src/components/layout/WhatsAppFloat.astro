---
import { buildWhatsAppUrl, WHATSAPP_LINK_ATTRS } from "@/lib/whatsapp";

interface Props {
  /** Origem da página atual, embutida na mensagem (PRD §7.2). */
  origem?: string;
}
const { origem = "Botão flutuante" } = Astro.props;
const href = buildWhatsAppUrl({ origem });
---

<a
  class="wa-float"
  href={href}
  {...WHATSAPP_LINK_ATTRS}
  aria-label="Falar no WhatsApp"
  data-track="click_whatsapp"
  data-origem={origem}
>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.003 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.257.59 4.46 1.71 6.402L3.2 28.8l6.57-1.72a12.74 12.74 0 0 0 6.232 1.587h.005c7.06 0 12.8-5.74 12.8-12.8 0-3.42-1.332-6.635-3.75-9.052A12.71 12.71 0 0 0 16.003 3.2zm0 23.04h-.004a10.62 10.62 0 0 1-5.41-1.48l-.388-.23-4.003 1.05 1.068-3.9-.253-.4a10.6 10.6 0 0 1-1.625-5.65c0-5.867 4.774-10.64 10.65-10.64a10.57 10.57 0 0 1 7.524 3.12 10.57 10.57 0 0 1 3.116 7.527c0 5.867-4.774 10.64-10.642 10.64zm5.835-7.967c-.32-.16-1.892-.933-2.185-1.04-.293-.107-.507-.16-.72.16-.213.32-.826 1.04-1.013 1.253-.187.213-.373.24-.693.08-.32-.16-1.35-.498-2.572-1.587-.95-.847-1.592-1.894-1.778-2.214-.187-.32-.02-.493.14-.652.144-.143.32-.373.48-.56.16-.187.213-.32.32-.533.107-.213.053-.4-.027-.56-.08-.16-.72-1.733-.986-2.373-.26-.624-.524-.54-.72-.55l-.613-.01c-.213 0-.56.08-.853.4-.293.32-1.12 1.094-1.12 2.667 0 1.573 1.146 3.093 1.306 3.307.16.213 2.253 3.44 5.46 4.823.763.33 1.358.527 1.822.674.766.244 1.463.21 2.014.127.614-.092 1.892-.773 2.158-1.52.267-.747.267-1.387.187-1.52-.08-.133-.293-.213-.613-.373z"
    ></path>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: clamp(16px, 4vw, 28px);
    bottom: clamp(16px, 4vw, 28px);
    z-index: 120;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 28px rgba(20, 36, 27, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .wa-float:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 16px 34px rgba(20, 36, 27, 0.34);
  }
  .wa-float:focus-visible {
    outline: 2px solid var(--gold-500);
    outline-offset: 3px;
  }
</style>
