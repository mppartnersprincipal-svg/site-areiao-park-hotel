---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import WhatsAppFloat from "@/components/layout/WhatsAppFloat.astro";
import CookieConsent from "@/components/layout/CookieConsent.astro";
import type { PageSeo } from "@/lib/seo";

interface Props extends PageSeo {
  includeHotelSchema?: boolean;
  /** Origem usada no botão flutuante de WhatsApp. */
  whatsappOrigem?: string;
}

const { whatsappOrigem, ...seo } = Astro.props;
---

<BaseLayout {...seo}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo">
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat origem={whatsappOrigem ?? seo.title} />
  <CookieConsent />
</BaseLayout>
