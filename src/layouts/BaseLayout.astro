---
import "@/styles/tokens.css";
import "@/styles/global.css";
import "@/styles/components.css";
import { site } from "@/data/site";
import { pageTitle, canonicalUrl, hotelJsonLd } from "@/lib/seo";
import type { PageSeo } from "@/lib/seo";

interface Props extends PageSeo {
  /** Inclui o JSON-LD do Hotel (true na Home e Localização). */
  includeHotelSchema?: boolean;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  ogImage = "/og/areiao-og.jpg",
  noindex = false,
  includeHotelSchema = false,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = canonicalUrl(path);
const ogImageUrl = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, site.url).toString();

const jsonLd = includeHotelSchema ? hotelJsonLd() : null;
const ga4 = site.analytics.ga4Id;
const gtmId = site.analytics.gtmId;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Google Tag Manager — o mais alto possível no <head> (PRD §7.8). */}
    {
      gtmId && (
        <>
          {/* Consent Mode v2 (LGPD): definido ANTES do GTM carregar. Analytics
              segue o consentimento implícito do banner (permitido até "Recusar");
              anúncios negados até consentimento explícito. */}
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            var areiaoConsent = "granted";
            try {
              if (localStorage.getItem("areiao-cookie-consent") === "decline")
                areiaoConsent = "denied";
            } catch (e) {}
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: areiaoConsent,
              functionality_storage: "granted",
              security_storage: "granted",
            });
          </script>
          <script is:inline define:vars={{ gtmId }}>
            (function (w, d, s, l, i) {
              w[l] = w[l] || [];
              w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
              var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != "dataLayer" ? "&l=" + l : "";
              j.async = true;
              j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
              f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", gtmId);
          </script>
        </>
      )
    }
    {/* End Google Tag Manager */}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fontes (mesmo conjunto do Design System) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    {/* TODO (cliente): adicionar ID do GA4 em site.ts para ativar analytics. */}
    {
      ga4 && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}
          />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", ga4);
            window.gtag = gtag;
          </script>
        </>
      )
    }
  </head>
  <body>
    {/* Google Tag Manager (noscript) — logo após a abertura do <body>. */}
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    {/* End Google Tag Manager (noscript) */}

    <slot />

    <script is:inline define:vars={{ gtmActive: Boolean(gtmId) }}>
      // Rastreio de cliques em CTAs (PRD §7.8): envia ao dataLayer os eventos
      // click_reservar / click_whatsapp com a origem (seção/promoção). O GTM
      // dispara as tags a partir desses eventos. Sem GTM/GA4, é no-op seguro.
      document.addEventListener("click", function (e) {
        var el = e.target instanceof Element ? e.target.closest("[data-track]") : null;
        if (!el) return;
        var event = el.getAttribute("data-track");
        var origem = el.getAttribute("data-origem") || "";
        var href = el.getAttribute("href") || "";
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: event,
          origem: origem,
          link_text: (el.textContent || "").trim(),
          link_url: href,
        });
        // GA4 direto (sem GTM): replica via gtag. Com GTM ativo, o container já
        // trata o evento do dataLayer — não duplicar aqui.
        if (!gtmActive && typeof window.gtag === "function") {
          window.gtag("event", event, { origem: origem });
        }
      });
    </script>
  </body>
</html>
